{
  "name": "orgmate",
  "version": "0.1.0",
  "private": true,
  "description": "Record meetings, transcribe them, and organize the result with structured templates on Azure.",
  "workspaces": [
    "packages/*",
    "apps/api"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
